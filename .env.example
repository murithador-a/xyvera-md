# ── Xyvera MD configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# Values here are placeholders — no real owner identity is embedded.

# Bot identity
BOT_NAME=Xyvera MD
BOT_VERSION=0.1.0
BOT_PREFIX=.
# Display name used for the WhatsApp profile / menu branding.
BOT_DISPLAY_NAME=Xyvera MD

# Owner configuration (required for owner-only commands).
# Comma-separated full phone numbers in international format, digits only,
# e.g. 15551234567 (no +, spaces, or dashes). Leave empty to disable
# owner commands until configured — the bot will tell you to configure it.
OWNER_NUMBERS=
OWNER_NAME=Owner

# Optional project links shown by .owner / .github
GITHUB_URL=
PROJECT_URL=

# Bot branding image (profile picture + .logo). Drop your logo at assets/bot-logo.png
# or point this at any PNG/JPG. Applied automatically on first connect; re-apply
# with .setbotpp.
BOT_IMAGE_PATH=assets/bot-logo.png

# Runtime
# public | private  (persisted mode can override this after first save)
BOT_MODE=public
# debug | info | warn | error
LOG_LEVEL=info
# Directory for temporary media (relative to project root)
TMP_DIR=tmp
# Directory for JSON persistence (relative to project root)
DATA_DIR=data

# ── External providers (optional — features report "not configured" without them) ──
# AI provider (used by .ai / .imagine / .translate when configured)
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# Image generation provider (used by .imagine)
IMAGINE_API_KEY=
IMAGINE_API_URL=
# Translation provider (used by .translate); empty = not configured
TRANSLATE_API_KEY=
# Weather (used by .weather)
WEATHER_API_KEY=
# Currency rates (used by .currency)
CURRENCY_API_KEY=
# Short URL provider (used by .shorturl) — must be a real, configured provider
SHORTURL_API_URL=
SHORTURL_API_KEY=
# Screenshot service (used by .screenshot) — must be a real, configured provider
SCREENSHOT_API_URL=
SCREENSHOT_API_KEY=
# Lyrics provider (used by .lyrics)
LYRICS_API_KEY=
# Media download provider (used by .play / .song / .video / .tiktok / .instagram)
MEDIA_API_URL=
MEDIA_API_KEY=
