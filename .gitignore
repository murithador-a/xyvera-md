# Dependencies
node_modules/

# Environment and secrets — never commit
.env
.env.*
!.env.example

# WhatsApp authentication / session state — never commit
data/session/
auth_info*/
*.session.json
session/

# Runtime data produced by the bot (settings, group configs, logs)
data/*.json
data/*.corrupt-*
data/qr.png
data/logs/
logs/
*.log

# Temporary media and scratch files
tmp/
*.tmp

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Coverage / build output
coverage/
dist/
build/
